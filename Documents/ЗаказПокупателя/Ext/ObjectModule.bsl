// Процедура осуществляет проведение документа "Заказ покупателя".
// Выполняется формирование расхода со склада и проверка отрицательных остатков.
// Если обнаруживается нехватка номенклатуры, транзакция отменяется.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	
	// Очищаем старые движения регистра, если документ перепроводится
	Движения.ОстаткиНоменклатуры.Очистить();
	Движения.ОстаткиНоменклатуры.Записать();
	
	// Формируем новые движения расхода по табличной части
	Для Каждого ТекСтрока Из Товары Цикл
		Движение = Движения.ОстаткиНоменклатуры.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрока.Товар; // Связываем твой реквизит Товар с измерением Номенклатура
		Движение.Количество = ТекСтрока.Количество;
		Движение.Сумма = ТекСтрока.Сумма; // Раз уж ты добавил этот ресурс, будем его тоже списывать
	КонецЦикла;
	
	// Физически записываем расход в базу до проверки (новая методика 1С)
	Движения.ОстаткиНоменклатуры.Записать();
	
	// Запрос проверяет, появились ли в базе отрицательные остатки после нашего списания
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиНоменклатурыОстатки.Номенклатура КАК Номенклатура,
		|	ОстаткиНоменклатурыОстатки.КоличествоОстаток КАК ОтрицательныйОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиНоменклатуры.Остатки(
		|			&МоментВремени,
		|			Номенклатура В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ЗаказПокупателяТовары.Товар КАК Товар
		|				ИЗ
		|					Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
		|				ГДЕ
		|					ЗаказПокупателяТовары.Ссылка = &Ссылка)) КАК ОстаткиНоменклатурыОстатки
		|ГДЕ
		|	ОстаткиНоменклатурыОстатки.КоличествоОстаток < 0";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	// Обходим результат запроса. Если запрос что-то нашел, значит мы ушли в минус.
	Пока Выборка.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не хватает позиции: " + Выборка.Номенклатура + ". Дефицит: " + (-Выборка.ОтрицательныйОстаток) + " шт.";
		Сообщение.Сообщить();
		
		Отказ = Истина; // Отменяем проведение документа
	КонецЦикла;
	
КонецПроцедуры